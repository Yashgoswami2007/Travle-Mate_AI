# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY=your_gemini_api_key_here

# SUPABASE CREDENTIALS: For two-layer database architecture and public destination cache
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key_here
SUPABASE_SECRET_KEY=your_supabase_secret_key_here

# OPENROUTESERVICE_API_KEY: For real road routing, directions and polyline geometries
OPENROUTESERVICE_API_KEY=your_openrouteservice_api_key_here
